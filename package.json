{
  "name": "bhaktigrow-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BhaktiGrow AI — Devotional Content Growth Platform",
  "workspaces": [
    "bhaktigrow-ai/frontend",
    "bhaktigrow-ai/backend"
  ],
  "scripts": {
    "build": "cd bhaktigrow-ai/frontend && npm install && npm run build",
    "install:frontend": "cd bhaktigrow-ai/frontend && npm install",
    "install:backend": "cd bhaktigrow-ai/backend && npm install",
    "test:frontend": "cd bhaktigrow-ai/frontend && npm test",
    "test:backend": "cd bhaktigrow-ai/backend && npm test"
  }
}
