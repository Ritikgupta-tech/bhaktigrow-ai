# ==========================================
# BhaktiGrow AI — Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/bhaktigrow

# Authentication (JWT)
JWT_SECRET=bhaktigrow_super_secure_dev_jwt_secret_change_in_production_32chars!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=bhaktigrow_cookie_signature_secret_dev

# AI Provider Configuration
# Supported providers: "generative-ai" | "gemini" | "openai" | "devotional-engine"
AI_PROVIDER=generative-ai
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUTUBE_API_KEY=
SERPAPI_API_KEY=

# Storage Provider Configuration
# Supported drivers: "local" | "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=bhaktigrow-media

# Social Platform OAuth & APIs (Optional until verified developer approval)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
